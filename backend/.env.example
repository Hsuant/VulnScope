# VulnScope 后端环境变量配置（复制为 .env 后修改）

# 应用
VULNSCOPE_APP_ENV=dev
VULNSCOPE_DEBUG=true

# 数据库：sqlite（默认）/ mysql
VULNSCOPE_DB_BACKEND=sqlite
# VULNSCOPE_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/vulnscope?charset=utf8mb4

# 缓存：inproc（默认）/ redis（v2 引入）
VULNSCOPE_CACHE_BACKEND=inproc

# 安全（生产环境务必更换为 32 字节以上随机字符串）
VULNSCOPE_SECRET_KEY=dev-only-change-me-in-production-32b
VULNSCOPE_ACCESS_TOKEN_EXPIRE_MINUTES=30
VULNSCOPE_REFRESH_TOKEN_EXPIRE_DAYS=7

# 种子管理员（首次启动时创建）
VULNSCOPE_SEED_ADMIN_USERNAME=admin
VULNSCOPE_SEED_ADMIN_PASSWORD=admin123
VULNSCOPE_SEED_ADMIN_EMAIL=admin@vulnscope.local