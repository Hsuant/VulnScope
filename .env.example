# VulnScope 部署环境变量（docker compose 自动读取项目根目录 .env）
# 复制为 .env 后填入真实值：cp .env.example .env

# ── 安全（必填，生产环境强制校验）──────────────────────
# JWT 签名密钥，生成：openssl rand -hex 32
VULNSCOPE_SECRET_KEY=change-me-openssl-rand-hex-32
# 默认管理员密码（首次启动创建账号，之后修改密码即可）
VULNSCOPE_ADMIN_PASSWORD=change-me-strong-password
VULNSCOPE_ADMIN_USERNAME=admin
VULNSCOPE_ADMIN_EMAIL=admin@vulnscope.local

# ── 登录限流（默认开启）──────────────────────────────
VULNSCOPE_LOGIN_RATE_LIMIT_ENABLED=true
VULNSCOPE_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
VULNSCOPE_LOGIN_RATE_LIMIT_WINDOW=300

# ── 日志级别（控制台可见；全部日志同时写入 logs/ 目录）────────────────
# DEBUG / INFO / WARNING / ERROR
VULNSCOPE_LOG_LEVEL=INFO
